<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Refuse cleartext traffic app-wide. The APK carries a Bearer API key,
         it must never be transmitted over HTTP. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
