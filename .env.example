NODE_ENV="production"
PORT="3000"

# ============================================================
# Self-hosted Supabase (Coolify / Docker) — example placeholders
# Replace every value below with your own instance's data.
# ============================================================
SERVICE_URL_SUPABASEKONG="https://db.your-domain.tld"
SERVICE_FQDN_SUPABASEKONG="db.your-domain.tld"
SERVICE_URL_SUPABASEKONG_8000="https://db.your-domain.tld:8000"
SERVICE_FQDN_SUPABASEKONG_8000="db.your-domain.tld:8000"

SERVICE_USER_ADMIN="admin"
SERVICE_PASSWORD_ADMIN="change-me-admin-password"
SERVICE_PASSWORD_JWT="change-me-32-char-jwt-secret"
SERVICE_PASSWORD_POSTGRES="change-me-postgres-password"
SERVICE_PASSWORD_PGMETACRYPTO="change-me-pgmeta-crypto-key"
SERVICE_PASSWORD_LOGFLARE="change-me-logflare-token"
SERVICE_PASSWORD_LOGFLAREPRIVATE="change-me-logflare-private-token"
SERVICE_PASSWORD_SUPAVISORSECRET="change-me-supavisor-secret"
SERVICE_PASSWORD_VAULTENC="change-me-vault-enc-key"
SERVICE_USER_MINIO="minio-user"
SERVICE_PASSWORD_MINIO="change-me-minio-password"

SERVICE_SUPABASEANON_KEY="your-anon-jwt"
SERVICE_SUPABASESERVICE_KEY="your-service-role-jwt"
SERVICE_ROLE_KEY_ASYMMETRIC=""
ANON_KEY_ASYMMETRIC=""

# ---------- Supabase core ----------
SUPABASE_URL="https://db.your-domain.tld"
SUPABASE_PUBLIC_URL="https://db.your-domain.tld"
SUPABASE_ANON_KEY="your-anon-jwt"
SUPABASE_PUBLISHABLE_KEY="your-anon-jwt"
SUPABASE_SERVICE_KEY="your-service-role-jwt"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-jwt"
SUPABASE_SECRET_KEY=""
SUPABASE_JWT_SECRET="change-me-32-char-jwt-secret"
SUPABASE_PROJECT_ID="your-project-id"
JWT_SECRET="change-me-32-char-jwt-secret"
JWT_EXPIRY="3600"
ANON_KEY="your-anon-jwt"
SERVICE_KEY="your-service-role-jwt"

# ---------- Vite client ----------
VITE_SUPABASE_URL="https://db.your-domain.tld"
VITE_SUPABASE_ANON_KEY="your-anon-jwt"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-jwt"
VITE_SUPABASE_PROJECT_ID="your-project-id"

# ---------- Paynoc mirrors (override guard) ----------
PAYNOC_SUPABASE_URL="https://db.your-domain.tld"
PAYNOC_SUPABASE_ANON_KEY="your-anon-jwt"
PAYNOC_SUPABASE_PUBLISHABLE_KEY="your-anon-jwt"
PAYNOC_SUPABASE_SERVICE_ROLE_KEY="your-service-role-jwt"
PAYNOC_SUPABASE_JWT_SECRET="change-me-32-char-jwt-secret"
PAYNOC_SUPABASE_PROJECT_ID="your-project-id"
PAYNOC_SECRET=""

# ---------- Postgres ----------
POSTGRES_PASSWORD="change-me-postgres-password"
POSTGRES_HOST="supabase-db"
POSTGRES_HOSTNAME="supabase-db"
POSTGRES_PORT="5432"
POSTGRES_DB="postgres"
PGPASSWORD="change-me-postgres-password"
DB_PASSWORD="change-me-postgres-password"

# ---------- PostgREST ----------
PGRST_DB_SCHEMAS="public,storage,graphql_public"
PGRST_DB_MAX_ROWS="1000"
PGRST_DB_EXTRA_SEARCH_PATH="public"
PGRST_JWT_SECRET="change-me-32-char-jwt-secret"
PGRST_APP_SETTINGS_JWT_SECRET="change-me-32-char-jwt-secret"

# ---------- GoTrue / Auth ----------
API_EXTERNAL_URL="https://db.your-domain.tld"
GOTRUE_SITE_URL="https://your-domain.tld"
SITE_URL="https://your-domain.tld"
ADDITIONAL_REDIRECT_URLS="https://your-domain.tld,https://your-domain.tld/auth/callback"
DISABLE_SIGNUP="false"
GOTRUE_JWT_SECRET="change-me-32-char-jwt-secret"
AUTH_JWT_SECRET="change-me-32-char-jwt-secret"
API_JWT_SECRET="change-me-32-char-jwt-secret"
METRICS_JWT_SECRET="change-me-32-char-jwt-secret"
ENABLE_EMAIL_SIGNUP="true"
ENABLE_EMAIL_AUTOCONFIRM="true"
ENABLE_ANONYMOUS_USERS="false"
ENABLE_PHONE_SIGNUP="true"
ENABLE_PHONE_AUTOCONFIRM="true"

# ---------- SMTP / Mailer ----------
SMTP_ADMIN_EMAIL=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_SENDER_NAME=""
MAILER_URLPATHS_INVITE="/auth/v1/verify"
MAILER_URLPATHS_CONFIRMATION="/auth/v1/verify"
MAILER_URLPATHS_RECOVERY="/auth/v1/verify"
MAILER_URLPATHS_EMAIL_CHANGE="/auth/v1/verify"
MAILER_TEMPLATES_INVITE=""
MAILER_TEMPLATES_CONFIRMATION=""
MAILER_TEMPLATES_RECOVERY=""
MAILER_TEMPLATES_MAGIC_LINK=""
MAILER_TEMPLATES_EMAIL_CHANGE=""
MAILER_SUBJECTS_INVITE=""
MAILER_SUBJECTS_CONFIRMATION=""
MAILER_SUBJECTS_RECOVERY=""
MAILER_SUBJECTS_MAGIC_LINK=""
MAILER_SUBJECTS_EMAIL_CHANGE=""

# ---------- Studio / Dashboard ----------
DASHBOARD_USERNAME="admin"
DASHBOARD_PASSWORD="change-me-admin-password"
STUDIO_DEFAULT_ORGANIZATION="YourOrg"
STUDIO_DEFAULT_PROJECT="your-project-id"

# ---------- Kong / storage timeouts ----------
KONG_STORAGE_CONNECT_TIMEOUT="60"
KONG_STORAGE_WRITE_TIMEOUT="3600"
KONG_STORAGE_READ_TIMEOUT="3600"
KONG_STORAGE_REQUEST_BUFFERING="false"
KONG_STORAGE_RESPONSE_BUFFERING="false"

# ---------- pg-meta ----------
PG_META_DB_PASSWORD="change-me-postgres-password"
PG_META_CRYPTO_KEY="change-me-pgmeta-crypto-key"
CRYPTO_KEY="change-me-pgmeta-crypto-key"

# ---------- Logflare ----------
LOGFLARE_API_KEY="change-me-logflare-token"
LOGFLARE_PUBLIC_ACCESS_TOKEN="change-me-logflare-token"
LOGFLARE_PRIVATE_ACCESS_TOKEN="change-me-logflare-private-token"

# ---------- Storage / MinIO ----------
MINIO_ROOT_USER="minio-user"
MINIO_ROOT_PASSWORD="change-me-minio-password"
AWS_ACCESS_KEY_ID="minio-user"
AWS_SECRET_ACCESS_KEY="change-me-minio-password"
STORAGE_PUBLIC_URL="https://db.your-domain.tld"
STORAGE_TENANT_ID="storage-single-tenant"
IMGPROXY_AUTO_WEBP="true"

# ---------- Functions ----------
FUNCTIONS_VERIFY_JWT="false"

# ---------- Realtime / Supavisor / Vault ----------
SECRET_PASSWORD_REALTIME=""
SECRET_KEY_BASE="change-me-supavisor-secret"
VAULT_ENC_KEY="change-me-vault-enc-key"

# ---------- Pooler ----------
POOLER_TENANT_ID="dev_tenant"
POOLER_DEFAULT_POOL_SIZE="20"
POOLER_MAX_CLIENT_CONN="100"
POOLER_DB_POOL_SIZE="5"

# ---------- Next.js (Studio) ----------
NEXT_PUBLIC_SUPABASE_URL="https://db.your-domain.tld"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-jwt"

# ---------- Third-party ----------
RESEND_API_KEY=""
GATEWAYAPI_API_KEY=""
LOVABLE_API_KEY=""
OPENAI_API_KEY=""
