PORT="3000"
NODE_ENV="production"

# ============================================================
# PayNOC production backend API gateway
# ============================================================
# IMPORTANT: this URL must serve /auth/v1/* and /rest/v1/*.
# Do not point the app to Studio, the PayNOC web app, or a basic-auth page.
VITE_SUPABASE_URL="https://db.paynoc.com"
SUPABASE_URL="https://db.paynoc.com"
PAYNOC_SUPABASE_URL="https://db.paynoc.com"

# Browser-visible anon/publishable key from your backend.
VITE_SUPABASE_PUBLISHABLE_KEY="<SERVICE_SUPABASEANON_KEY>"
VITE_SUPABASE_ANON_KEY="<SERVICE_SUPABASEANON_KEY>"
SUPABASE_PUBLISHABLE_KEY="<SERVICE_SUPABASEANON_KEY>"
SUPABASE_ANON_KEY="<SERVICE_SUPABASEANON_KEY>"
PAYNOC_SUPABASE_PUBLISHABLE_KEY="<SERVICE_SUPABASEANON_KEY>"
PAYNOC_SUPABASE_ANON_KEY="<SERVICE_SUPABASEANON_KEY>"

# Server-only values. Set these in Coolify/runtime secrets; never expose them in browser code.
SUPABASE_SERVICE_ROLE_KEY="<SERVICE_SUPABASESERVICE_KEY>"
PAYNOC_SUPABASE_SERVICE_ROLE_KEY="<SERVICE_SUPABASESERVICE_KEY>"
SUPABASE_JWT_SECRET="<SERVICE_PASSWORD_JWT>"
PAYNOC_SUPABASE_JWT_SECRET="<SERVICE_PASSWORD_JWT>"

VITE_SUPABASE_PROJECT_ID="paynoc"
SUPABASE_PROJECT_ID="paynoc"
PAYNOC_SUPABASE_PROJECT_ID="paynoc"

# Public app URLs
SITE_URL="https://paynoc.bd"
APEX_DOMAIN="paynoc.bd"

# Optional integrations
RESEND_API_KEY=""
GATEWAYAPI_API_KEY=""
LOVABLE_API_KEY=""
OPENAI_API_KEY=""