NODE_ENV=production
PORT=3000

# ---- Paynoc self-hosted Supabase (Coolify) ----
VITE_SUPABASE_URL=https://db.paynoc.bd
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-jwt
VITE_SUPABASE_ANON_KEY=your-anon-jwt
VITE_SUPABASE_PROJECT_ID=paynoc

SUPABASE_URL=https://db.paynoc.bd
SUPABASE_PUBLISHABLE_KEY=your-anon-jwt
SUPABASE_ANON_KEY=your-anon-jwt
SUPABASE_SERVICE_ROLE_KEY=your-service-role-jwt
SUPABASE_JWT_SECRET=your-jwt-secret
SUPABASE_PROJECT_ID=paynoc

# Paynoc mirrors (take priority — never overwritten by managed defaults)
PAYNOC_SUPABASE_URL=https://db.paynoc.bd
PAYNOC_SUPABASE_ANON_KEY=your-anon-jwt
PAYNOC_SUPABASE_PUBLISHABLE_KEY=your-anon-jwt
PAYNOC_SUPABASE_SERVICE_ROLE_KEY=your-service-role-jwt
PAYNOC_SUPABASE_JWT_SECRET=your-jwt-secret
PAYNOC_SUPABASE_PROJECT_ID=paynoc

# ---- App secrets ----
PAYNOC_SECRET=  # openssl rand -hex 32
RESEND_API_KEY=
GATEWAYAPI_API_KEY=
LOVABLE_API_KEY=
OPENAI_API_KEY=
